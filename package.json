{
  "name": "bead-pattern-generator",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "豆豆图纸 · 纯前端拼豆图纸生成器（分步页面 / 六主题 / 本地抠图构图 / 分享图导出）",
  "scripts": {
    "dev": "vite",
    "predev": "pnpm ort:sync",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "prebuild": "pnpm ort:sync",
    "models:download": "node scripts/download-models.mjs",
    "ort:sync": "node scripts/sync-ort-assets.mjs",
    "smoke:segmentation": "node scripts/smoke-segmentation.mjs",
    "quality:run": "node scripts/quality-run.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "samples": "node scripts/make-samples.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:palette": "node scripts/validate-palette.mjs src/core/palette/fixtures/artkal-s@beadcolors-f97ff428.json && node scripts/validate-palette.mjs src/core/palette/fixtures/mard-221@pindou-color-data.json",
    "fonts:pdf": "node scripts/build-pdf-font.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "canvas-confetti": "^1.9.4",
    "fast-png": "^8.0.0",
    "onnxruntime-web": "1.30.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "subset-font": "^2.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
